# ---------------------------------------------------------------
# Authentification
#   dev   : faux fournisseur OAuth2 local (mock-oauth2), aucun compte requis ; jetons : bash scripts/jeton.sh B001
#   auth0 : jetons JWT émis par Auth0 (configuration en Terraform : infra/terraform/auth0)
# ---------------------------------------------------------------
AUTH_MODE=auth0

# Tenant Auth0 (sans https://), par exemple surfwear-demo.eu.auth0.com
AUTH0_DOMAIN=votre-tenant.eu.auth0.com
# Identifiant de l'API créée dans Auth0 (APIs > Create API > Identifier)
AUTH0_AUDIENCE=https://api.surfwear.example

# Applications "Machine to Machine" Auth0 (boutiques simulées et commerciaux).
# Valeurs produites par Terraform : bash scripts/env-depuis-terraform.sh
AUTH0_B001_CLIENT_ID=
AUTH0_B001_CLIENT_SECRET=
AUTH0_B002_CLIENT_ID=
AUTH0_B002_CLIENT_SECRET=
AUTH0_B003_CLIENT_ID=
AUTH0_B003_CLIENT_SECRET=
AUTH0_COMMERCIAL_CLIENT_ID=
AUTH0_COMMERCIAL_CLIENT_SECRET=

# ---------------------------------------------------------------
# Infrastructure (valeurs de démonstration, à changer en production)
# ---------------------------------------------------------------
POSTGRES_PASSWORD=surfwear
RABBITMQ_USER=surfwear
RABBITMQ_PASSWORD=surfwear
